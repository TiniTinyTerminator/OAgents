#!/usr/bin/python3
# Kilo Code: token usage from its VS Code task history (any VS Code-family editor).
import os
import sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _agentusage import HOME, Usage, cached_scan, emit, max_age, parse_args
import _cline_tasks

ROOTS = _cline_tasks.task_roots(["kilocode.kilo-code"], [])


def scan():
  usage = Usage()
  complete = _cline_tasks.scan(usage, ROOTS, "kilocode")
  return usage.stats(), complete


args = parse_args()
emit("kilocode", "Kilo Code", cached_scan("kilocode", scan, max_age(args), str(ROOTS)))
