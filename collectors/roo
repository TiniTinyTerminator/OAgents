#!/usr/bin/python3
# Roo Code: token usage from its VS Code task history (any VS Code-family editor).
import os
import sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _agentusage import HOME, Usage, cached_scan, emit, max_age, parse_args
import _cline_tasks

ROOTS = _cline_tasks.task_roots(["rooveterinaryinc.roo-cline"], [])


def scan():
  usage = Usage()
  complete = _cline_tasks.scan(usage, ROOTS, "roo")
  return usage.stats(), complete


args = parse_args()
emit("roo", "Roo Code", cached_scan("roo", scan, max_age(args), str(ROOTS)))
